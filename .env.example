# =============================================================================
# logitaxAgent - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the actual values.
# NEVER commit the .env file with real credentials to the repository.
# =============================================================================

# --- LLM Configuration ---
LLM_MODEL_NAME=gpt-4o-mini
LLM_ENDPOINT=https://api.openai.com/v1

# --- Storage Paths ---
CHROMADB_PATH=./data/chromadb
SQLITE_PATH=./data/logitax.db

# --- Tool_Transicao Configuration ---
# Mode: "local" (usa tabela JSON diretamente) ou "api" (tenta HTTP, fallback local)
TOOL_TRANSICAO_MODE=local
# URL do endpoint (usado apenas no modo "api")
# TOOL_TRANSICAO_URL=http://localhost:8000/tools/tabela-transicao

# --- Integration ---
WEBHOOK_N8N_URL=http://localhost:5678/webhook/simulacao-concluida

# --- Thresholds ---
DELTA_THRESHOLD_PCT=15
