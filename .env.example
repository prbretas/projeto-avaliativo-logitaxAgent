# =============================================================================
# logitaxAgent - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the actual values.
# NEVER commit the .env file with real credentials to the repository.
# =============================================================================

# --- LLM Configuration ---
# O sistema é compatível com qualquer provider OpenAI-compatible:
# - Ollama (local): endpoint=http://localhost:11434/v1, model=llama3.1, key=ollama
# - OpenAI: endpoint=https://api.openai.com/v1, model=gpt-4o-mini, key=sk-...
# - Groq: endpoint=https://api.groq.com/openai/v1, model=llama-3.1-70b-versatile, key=gsk_...
# - Azure OpenAI: endpoint=https://seu-recurso.openai.azure.com/openai/deployments/seu-model/v1
# - LM Studio (local): endpoint=http://localhost:1234/v1, model=local-model, key=lm-studio

LLM_MODEL_NAME=llama3.1
LLM_ENDPOINT=http://localhost:11434/v1
OPENAI_API_KEY=ollama

# --- Storage Paths ---
CHROMADB_PATH=./data/chromadb
SQLITE_PATH=./data/logitax.db

# --- Tool_Transicao Configuration ---
# Mode: "local" (usa tabela JSON diretamente) ou "api" (tenta HTTP, fallback local)
TOOL_TRANSICAO_MODE=local
# URL do endpoint (usado apenas no modo "api")
# TOOL_TRANSICAO_URL=http://localhost:8000/tools/tabela-transicao

# --- Integration ---
WEBHOOK_N8N_URL=http://localhost:5678/webhook/simulacao-concluida

# --- Thresholds ---
DELTA_THRESHOLD_PCT=15
